SAMSUNG_LIST_ID=YOUR_SAMSUNG_FOOD_LIST_ID

# Optional credential fallback. The proven/stable auth path is the persistent manual browser session.
SAMSUNG_ACCOUNT_EMAIL=
SAMSUNG_ACCOUNT_PASSWORD=
SAMSUNG_FOOD_TOKEN=

LOGIN_UI_USER=bagger
LOGIN_UI_PASSWORD=CHANGE_ME
LOGIN_UI_PUID=1000
LOGIN_UI_PGID=1000
TZ=Europe/Copenhagen


# Public iPhone API.
# Generate a long random value locally on the QNAP, e.g.:
# openssl rand -hex 32
MOBILE_API_TOKEN=replace_with_a_long_random_token
CORE_API_BASE=http://bagger-shopping:8080

# Apple Push Notification service. Download one APNs .p8 key from Apple
# Developer and store it only in backend/secrets on the QNAP.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=dk.chewbagger.BaggerShopping
APNS_PRIVATE_KEY_PATH=/run/secrets/AuthKey.p8
FLYER_PUSH_INTERVAL_SECONDS=3600
FLYER_PUSH_STORE_PATH=/data/flyer-push.json
